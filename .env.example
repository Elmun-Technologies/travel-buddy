# Copy to .env.local for local dev. Real values live only in Coolify env / GitHub Secrets.
APP_NAME=Travel Buddy
APP_ENV=development            # development | staging | production
DATABASE_URL=postgres://postgres:dev@localhost:54329/tvb
RUN_MIGRATIONS=false           # worker: true on staging only
APP_URL=http://localhost:3000
# S3-compatible storage (SeaweedFS). Used from phase 2 (uploads); path-style required.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_FILES=tb-files
S3_FORCE_PATH_STYLE=true
# Sign in with Google (optional). Redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Telegram (web: login verification; worker: the bot itself). One bot token per environment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Must be set explicitly in every environment: development | staging | production (the worker refuses to start otherwise).
# Errors (Sentry). Server/worker: SENTRY_DSN (Coolify). Browser: NEXT_PUBLIC_SENTRY_DSN (GitHub Actions variable, build-time).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only (GitHub Secret): stable Server Action IDs across deploys. `openssl rand -base64 32`
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Product analytics (PostHog Cloud EU). Empty = off. See docs/runbooks/analytics.md
POSTHOG_KEY=
# Shown on the terms / privacy / help pages. Empty lines are left out of the page.
LEGAL_ENTITY=
LEGAL_ADDRESS=
SUPPORT_EMAIL=
SUPPORT_TELEGRAM=
# Optional
ADMIN_TELEGRAM_IDS=
TRAVELPAYOUTS_MARKER=
CREATOR_ENABLED=
INSTAGRAM_HANDLE=
